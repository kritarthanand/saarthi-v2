# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_CHAT_MODEL_OPUS=claude-opus-4-7

# Supabase — shared project with V1
SUPABASE_URL=https://pedalbyxrzkltfbzbewc.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

PORT=3001

# Dev auth — used by FastAPI endpoints until real JWT auth lands (see TODO: auth)
SAARTHI_DEV_USER_ID=<uuid-from-auth.users>

# Shared secret required to call POST /cron/daily-reset. If unset, the endpoint
# returns 403 — set this even in dev to flip on manual reset triggers.
CRON_SECRET=<random-string>

# Test mode (never in production)
# IS_TEST=true
# SAARTHI_TEST_USER_ID=<uuid>

# Obsidian export — the server writes voice sessions into your daily note.
# Unset OBSIDIAN_VAULT_PATH disables export entirely (no error, just a no-op).
# The folder + format must match your Daily Notes plugin settings, or Saarthi
# will create a second note alongside the one you actually use.
OBSIDIAN_VAULT_PATH=/Users/<you>/Obsidian/<vault>
OBSIDIAN_DAILY_FOLDER=Daily
OBSIDIAN_DAILY_FORMAT=YYYY-MM-DD

# ── Notion export (alternative//additional target to Obsidian) ────────────────
# Unset NOTION_TOKEN disables it entirely (no error, just a no-op). Both this
# and the Obsidian export can be on at once; they write to different places.
#
# Setup: create an internal integration at https://www.notion.so/my-integrations,
# then share ONE parent page with it (page ••• menu -> Connections -> your
# integration). The "Saarthi Voice Sessions" database is created under that page
# on first export; pin its id below afterwards to skip the lookup each time.
# NOTION_TOKEN=ntn_...
# NOTION_PARENT_PAGE_ID=<32-char id from the parent page's URL>
# NOTION_DATABASE_ID=<optional; logged after the database is first created>
